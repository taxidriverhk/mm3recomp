+        s_tot_words += words;
+        return 0;
+    }
+    words += pb_walk_segment_j(target, put_va, 0, &jumps, &unknown, NULL);
+    s_tot_words += words;
+    s_tot_unknown += unknown;
+    s_tot_jumps += jumps;
+    s_tot_segments++;
+    return 1;
+}

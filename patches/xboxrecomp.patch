+
+/* PUT came back below the previous PUT: the ring wrapped. The commands from the
+ * previous PUT run up to the JUMP D3D wrote at the end of what it had queued,
+ * and carry on from the JUMP's target up to the new PUT. Scanning the previous
+ * PUT to the highest PUT ever seen, then the lowest PUT seen to the new one,
+ * dropped everything queued between the last kick and the JUMP (and anything
+ * below the lowest PUT): a draw and a render-target switch every wrap, which
+ * in MM3 is a frame with the HUD drawn into a 16x16 surface, or black blocks,
+ * every few seconds. Returns 0 (and says so, a few times) when no JUMP to at or
+ * below the new PUT turned up. */
+int nv2a_pb_scan_wrap(uint32_t last_va, uint32_t put_va)
+{
+    uint32_t words, jumps = 0, unknown = 0, target = 0;
+
+    if (!pb_walk_enabled())
+        return 1;
+    if (s_exec_enabled) {
+        extern void nv2a_pb_exec_walk_begin(void);
+        nv2a_pb_exec_walk_begin();
+    }
+    words = pb_walk_segment_j(last_va, last_va + 0x400000u, 0, &jumps, &unknown, &target);

+static double s_perf_xf, s_perf_asm, s_perf_flush;
+static uint64_t s_perf_verts;
+
+static double perf_now(void)
+{
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return (double)t.QuadPart * 1000.0 / (double)s_perf_freq.QuadPart;
+}
+
+static void perf_report(void)
+{
+    static double t0, busy0;
+    double now;
+    if (s_perf < 0) {
+        s_perf = getenv("RECOMP_PERF") != NULL;
+        QueryPerformanceFrequency(&s_perf_freq);
+    }
+    if (!s_perf)
+        return;
+    now = perf_now();
+    if (!t0) { t0 = now; return; }
+    if (now - t0 >= 2000.0) {
+        double w = now - t0;
+        fprintf(stderr, "[PERF] %.0f ms: vsh %.0f ms (%.1f%%, %llu verts), assemble %.0f ms, backend %.0f ms, flips %u\n",
